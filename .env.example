# ============================================================
# DHIS2 PIH
# ============================================================
DHIS2_URL=https://yourURL/dhis
DHIS2_USERNAME=your_pih_username_here
DHIS2_PASSWORD=your_pih_password_here

# ============================================================
# DHIS2 MOH
# ============================================================
MOH_DHIS2_URL=https://yourURL/dhis
MOH_DHIS2_USERNAME=your_moh_username_here
MOH_DHIS2_PASSWORD=your_moh_password_here

# ============================================================
# PostgreSQL
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dhis2_data
DB_USER=dhis2_user
DB_PASSWORD=strong_password_here

# ============================================================
# Filesystem (optional, defaults shown)
# ============================================================
JSON_TEMP_DIR=json_temp
JSON_ARCHIVE_DIR=json_archive
